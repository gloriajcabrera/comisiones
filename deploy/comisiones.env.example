# Runtime mode. Keep these values in production.
COMMISSIONS_ENV=production
COMMISSIONS_DB_BACKEND=postgresql
COMMISSIONS_POSTGRES_DSN=

# Backup connection. Keep the password out of the DSN and in a root-owned
# pgpass file with mode 0600. Backups are never deleted automatically.
COMMISSIONS_POSTGRES_BACKUP_DSN=postgresql://backup_user@localhost:5432/comisiones
PGPASSFILE=/etc/servimeters/comisiones.pgpass
COMMISSIONS_BACKUP_DIR=/var/backups/servimeters-comisiones
COMMISSIONS_AUTH_MODE=ldap
LOCAL_TEST_AUTH_ENABLED=false
COMMISSION_APP_DEMO=false
COMMISSIONS_RULES_VERSION=engine-2026-11-period-scope-v2

# Interfaz web. Restringir el puerto a la red interna mediante firewall.
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501

# Structured logs captured by systemd.
COMMISSIONS_LOG_LEVEL=INFO
COMMISSIONS_LOG_FORMAT=json

# Active Directory / LDAP. Supply secrets only in /etc, never in Git.
LDAP_SERVER=
LDAP_PORT=636
LDAP_DOMAIN=
LDAP_BASE_DN=
LDAP_USE_TLS=true
LDAP_TIMEOUT_SECONDS=10
LDAP_SEARCH_USER=
LDAP_SEARCH_PASSWORD=

# NetSuite REST SuiteQL in production.
NETSUITE_PROVIDER=api
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_API_TIMEOUT_SECONDS=30
NETSUITE_API_PAGE_SIZE=1000
NETSUITE_API_MAX_RESULTS=100000
NETSUITE_API_MAX_RETRIES=3

# ODBC fallback for controlled transition or diagnostics.
NETSUITE_ODBC_DSN=NetSuite2
NETSUITE_ODBC_USER=
NETSUITE_ODBC_PASSWORD=
NETSUITE_ODBC_TIMEOUT_SECONDS=20

# Optional SMTP delivery. Leave host empty to disable sending.
COMMISSIONS_SMTP_HOST=
COMMISSIONS_SMTP_PORT=587
COMMISSIONS_SMTP_FROM=
COMMISSIONS_SMTP_USERNAME=
COMMISSIONS_SMTP_PASSWORD=
COMMISSIONS_SMTP_STARTTLS=true
COMMISSIONS_SMTP_SSL=false
COMMISSIONS_SMTP_TIMEOUT=30
